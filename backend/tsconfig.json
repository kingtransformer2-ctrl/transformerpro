{
  "compilerOptions": {
    "target": "es2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "migrations",
    "scripts",
    "src/test-*.ts",
    "src/test-db.ts",
    "src/check-triggers.ts",
    "src/set-known-pins.ts",
    "src/update-pins.ts"
  ]
}
